#!/usr/bin/env bash
set -euo pipefail

if [ "$ASDF_INSTALL_TYPE" != version ]; then
  echo "only version installs are supported" >&2
  exit 1
fi

os=$(uname -s | tr '[:upper:]' '[:lower:]')
case "$(uname -m)" in
  x86_64 | amd64) arch=amd64 ;;
  arm64 | aarch64) arch=arm64 ;;
  *)
    echo "unsupported arch: $(uname -m)" >&2
    exit 1
    ;;
esac

asset="educates-${os}-${arch}"
base="https://github.com/educates/educates-training-platform/releases/download/${ASDF_INSTALL_VERSION}"
cd "$ASDF_DOWNLOAD_PATH"

curl -fsSL -o educates "$base/$asset"
curl -fsSL -o checksums.txt "$base/checksums.txt"

expected=$(awk -v f="$asset" '$2 == f {print $1}' checksums.txt)
if command -v sha256sum >/dev/null; then
  actual=$(sha256sum educates | cut -d' ' -f1)
else
  actual=$(shasum -a 256 educates | cut -d' ' -f1)
fi
if [ -z "$expected" ] || [ "$expected" != "$actual" ]; then
  echo "checksum mismatch for $asset" >&2
  exit 1
fi
