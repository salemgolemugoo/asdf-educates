#!/usr/bin/env bash
set -euo pipefail

# Releases before 2.6.0 (and its pre-releases) lack CLI binaries or checksums.txt.
# Sort key "X.Y.Z.<pre>.N" with "z" for final releases, so rc < final.
git ls-remote --tags --refs https://github.com/educates/educates-training-platform |
  awk -F/ '{print $3}' |
  awk -F. '($1 > 2 || ($1 == 2 && $2 >= 6)) && !/^2\.6\.0-/' |
  sed 'h; s/-/./; s/$/.z.0/; G; s/\n/ /' |
  LC_ALL=C sort -t. -k1,1n -k2,2n -k3,3n -k4,4 -k5,5n |
  awk '{print $2}' | xargs echo
