#!/usr/bin/env bash
set -euo pipefail

[ "$ASDF_INSTALL_TYPE" = version ] || {
  echo "only version installs are supported" >&2
  exit 1
}

os=$(uname -s | tr '[:upper:]' '[:lower:]')
case "$(uname -m)" in
  x86_64 | amd64) arch=amd64 ;;
  arm64 | aarch64) arch=arm64 ;;
  *)
    echo "unsupported arch: $(uname -m)" >&2
    exit 1
    ;;
esac

asset="educates-${os}-${arch}"
base="https://github.com/educates/educates-training-platform/releases/download/${ASDF_INSTALL_VERSION}"
dir="${ASDF_INSTALL_PATH}/bin"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

curl -fsSL -o "$tmp/$asset" "$base/$asset"
curl -fsSL -o "$tmp/checksums.txt" "$base/checksums.txt"

expected=$(awk -v f="$asset" '$2 == f {print $1}' "$tmp/checksums.txt")
if command -v sha256sum >/dev/null; then
  actual=$(sha256sum "$tmp/$asset" | cut -d' ' -f1)
else
  actual=$(shasum -a 256 "$tmp/$asset" | cut -d' ' -f1)
fi
[ -n "$expected" ] && [ "$expected" = "$actual" ] || {
  echo "checksum mismatch for $asset" >&2
  exit 1
}

mkdir -p "$dir"
install -m 0755 "$tmp/$asset" "$dir/educates"
